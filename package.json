{
  "name": "qdoc",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev:api": "pnpm --filter @qdoc/api dev",
    "dev:web": "pnpm --filter @qdoc/web dev",
    "dev:worker": "pnpm --filter @qdoc/worker dev",
    "lint": "pnpm -r --if-present lint",
    "typecheck": "pnpm -r --if-present typecheck"
  }
}
