<Window x:Class="QDocHospitalApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="QDoc Hospital Operations"
        Height="900"
        Width="1460"
        MinWidth="1180"
        MinHeight="760"
        Loaded="WindowLoaded">
    <Grid Background="#F6F4F3">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Margin="20" Padding="18" Background="White" CornerRadius="18" BorderBrush="#E1D5D1" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,18,0">
                    <TextBlock Text="QDoc Hospital Console" FontSize="28" FontWeight="Bold" Foreground="#2A2323" />
                    <TextBlock Text="SQL Server-backed queue operations for hospital staff." Margin="0,6,0,0" Foreground="#6F6664" />
                    <TextBlock x:Name="ConnectionStatusText" Margin="0,10,0,0" Foreground="#8F1D1D" FontWeight="SemiBold" Text="Database connection: checking..." />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,14,0">
                    <TextBlock Text="Hospital" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="#4B3B39" />
                    <ComboBox x:Name="HospitalComboBox" MinHeight="40" DisplayMemberPath="DisplayName" SelectionChanged="HospitalSelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,14,0">
                    <TextBlock Text="Queue" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="#4B3B39" />
                    <ComboBox x:Name="QueueComboBox" MinHeight="40" DisplayMemberPath="DisplayName" SelectionChanged="QueueSelectionChanged" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,14,0">
                    <TextBlock Text="Queue Status" Margin="0,0,0,6" FontWeight="SemiBold" Foreground="#4B3B39" />
                    <ComboBox x:Name="QueueStatusComboBox" MinHeight="40" SelectionChanged="QueueStatusSelectionChanged">
                        <ComboBoxItem Content="Open" />
                        <ComboBoxItem Content="Paused" />
                        <ComboBoxItem Content="Closed" />
                    </ComboBox>
                </StackPanel>

                <Button Grid.Column="4"
                        Content="Reload"
                        Click="ReloadAllClick"
                        Background="#8F1D1D"
                        Foreground="White"
                        Padding="18,10"
                        MinHeight="42"
                        BorderThickness="0"
                        FontWeight="Bold"
                        VerticalAlignment="Bottom" />
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Margin="20,0,20,20">
            <TabItem Header="Patients">
                <Grid Margin="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="360" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Padding="18" Background="White" CornerRadius="16" BorderBrush="#E1D5D1" BorderThickness="1">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="Patient Management" FontSize="22" FontWeight="Bold" Foreground="#2A2323" />
                                <TextBlock Text="Create and maintain customers stored in SQL Server." Margin="0,6,0,18" Foreground="#6F6664" TextWrapping="Wrap" />

                                <TextBlock Text="Name" FontWeight="SemiBold" Foreground="#4B3B39" />
                                <TextBox x:Name="PatientNameTextBox" Margin="0,6,0,14" MinHeight="38" />

                                <TextBlock Text="Phone" FontWeight="SemiBold" Foreground="#4B3B39" />
                                <TextBox x:Name="PatientContactTextBox" Margin="0,6,0,14" MinHeight="38" />

                                <TextBlock Text="Auth User ID (optional)" FontWeight="SemiBold" Foreground="#4B3B39" />
                                <TextBox x:Name="PatientAuthUserIdTextBox" Margin="0,6,0,18" MinHeight="38" />

                                <WrapPanel Margin="0,0,0,10">
                                    <Button Content="Add" Width="96" Margin="0,0,8,8" Click="AddPatientClick" Background="#8F1D1D" Foreground="White" BorderThickness="0" />
                                    <Button Content="Update" Width="96" Margin="0,0,8,8" Click="UpdatePatientClick" />
                                    <Button Content="Delete" Width="96" Margin="0,0,8,8" Click="DeletePatientClick" />
                                    <Button Content="Refresh" Width="96" Margin="0,0,8,8" Click="RefreshPatientsClick" />
                                </WrapPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </Border>

                    <Border Grid.Column="2" Padding="12" Background="White" CornerRadius="16" BorderBrush="#E1D5D1" BorderThickness="1">
                        <DataGrid x:Name="PatientGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionChanged="PatientGridSelectionChanged"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*" />
                                <DataGridTextColumn Header="Phone" Binding="{Binding Contact}" Width="*" />
                                <DataGridTextColumn Header="Auth User ID" Binding="{Binding AuthUserId}" Width="*" />
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Queue Operations">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="220" />
                    </Grid.RowDefinitions>

                    <Border Padding="18" Background="White" CornerRadius="16" BorderBrush="#E1D5D1" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Create Queue Ticket" FontSize="22" FontWeight="Bold" Foreground="#2A2323" />
                                <TextBlock Text="Choose a patient and add a live queue ticket to the selected department queue." Margin="0,6,0,14" Foreground="#6F6664" TextWrapping="Wrap" />
                                <TextBlock Text="Patient" FontWeight="SemiBold" Foreground="#4B3B39" />
                                <ComboBox x:Name="QueuePatientComboBox" Margin="0,6,0,14" MinHeight="40" DisplayMemberPath="Name" />
                                <Button Content="Add Ticket" Click="AddTicketClick" Background="#8F1D1D" Foreground="White" BorderThickness="0" MinHeight="40" />
                            </StackPanel>

                            <WrapPanel Grid.Column="2" VerticalAlignment="Bottom">
                                <Button Content="Call Next" Width="110" Margin="0,0,8,8" Click="CallNextClick" />
                                <Button Content="In Service" Width="110" Margin="0,0,8,8" Click="MarkInServiceClick" />
                                <Button Content="Done" Width="110" Margin="0,0,8,8" Click="CompleteTicketClick" />
                                <Button Content="No Show" Width="110" Margin="0,0,8,8" Click="MarkNoShowClick" />
                                <Button Content="Cancel" Width="110" Margin="0,0,8,8" Click="CancelTicketClick" />
                                <Button Content="Refresh Queue" Width="120" Margin="0,0,8,8" Click="RefreshQueueClick" />
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Padding="12" Background="White" CornerRadius="16" BorderBrush="#E1D5D1" BorderThickness="1">
                        <DataGrid x:Name="QueueGrid"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  SelectionChanged="QueueGridSelectionChanged"
                                  RowHeaderWidth="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#" Binding="{Binding QueueNumber}" Width="80" />
                                <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="2*" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*" />
                                <DataGridTextColumn Header="Stage1" Binding="{Binding Stage1State}" Width="*" />
                                <DataGridTextColumn Header="Stage2" Binding="{Binding Stage2State}" Width="*" />
                                <DataGridTextColumn Header="Created" Binding="{Binding CreatedAtText}" Width="*" />
                                <DataGridTextColumn Header="Updated" Binding="{Binding UpdatedAtText}" Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>

                    <Border Grid.Row="4" Padding="16" Background="White" CornerRadius="16" BorderBrush="#E1D5D1" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Queue Activity Log" FontSize="18" FontWeight="Bold" Foreground="#2A2323" />
                            <ListBox Grid.Row="2" x:Name="QueueLogListBox" BorderThickness="0" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <TabItem Header="Voice Alerts">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="16" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Padding="18" Background="White" CornerRadius="16" BorderBrush="#E1D5D1" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Voice Alert Demo" FontSize="22" FontWeight="Bold" Foreground="#2A2323" />
                            <TextBlock Text="NotificationLog writes are stored in SQL Server for Stage1 and Stage2. Voice test events remain local demo logs." Margin="0,6,0,14" Foreground="#6F6664" TextWrapping="Wrap" />
                            <TextBlock x:Name="VoiceTicketSummaryText" FontWeight="SemiBold" Foreground="#4B3B39" Text="No ticket selected" />
                            <WrapPanel Margin="0,14,0,0">
                                <Button Content="Send Voice Test" Width="140" Margin="0,0,8,8" Click="SendVoiceTestClick" />
                                <Button Content="Send Stage1" Width="120" Margin="0,0,8,8" Click="SendStage1Click" />
                                <Button Content="Send Stage2" Width="120" Margin="0,0,8,8" Click="SendStage2Click" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Padding="16" Background="White" CornerRadius="16" BorderBrush="#E1D5D1" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="8" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Voice Log" FontSize="18" FontWeight="Bold" Foreground="#2A2323" />
                            <ListBox Grid.Row="2" x:Name="VoiceLogListBox" BorderThickness="0" />
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
